
#Область ОбработчикиСобытийФормы

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами 
	
	ПечатьЭтикеток.ВывестиКомандыПечати(ЭтотОбъект);

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Количество = 1;
		Объект.Местоположение = Перечисления.Местоположения.Неопределено;
	Иначе
		СтрукЦены = НоменклатураСервер.ПолучитьЦены(Объект.Ссылка);
		ЦенаАктуальная		= СтрукЦены.ЦенаНаДату;
		ЦенаПриобретения	= СтрукЦены.ЦенаПриобретения;
		ДатаПриобретения	= СтрукЦены.ДатаПриобретения;

		ЗаполнитьТаблицуКартинок(Объект.Ссылка);
	КонецЕсли;

	ЭлементОтбора = СписокРазмещение.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьКартинку();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);

	ЗаполнитьТаблицуКартинок(Объект.Ссылка);

	ПоказатьКартинку();

КонецПроцедуры

Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	ВариантРазмещения = НоменклатураСервер.ПолучитьНомерРазмещения(ТекущийОбъект.Ссылка);
	ТекущийОбъект.ВариантРазмещения = ВариантРазмещения;

	МассивМест = НоменклатураСервер.ПолучитьРазмещения(ТекущийОбъект.Ссылка);
	
	ГруппаАрхив = Справочники.Номенклатура.НайтиПоНаименованию("00 АРХИВ", Истина);

	Если МассивМест.Количество() > 0 Тогда
		ТекущийОбъект.Местоположение = НоменклатураСервер.ПолучитьМестоположениеПоРазмещению(МассивМест);
	ИначеЕсли ТекущийОбъект.ПринадлежитЭлементу(ГруппаАрхив) Тогда
		ТекущийОбъект.Местоположение = Перечисления.Местоположения.Архив;
	КонецЕсли;
	
	Если ВариантРазмещения = 3 Тогда
		Возврат; // в косвенном размещении нет кол-ва
	КонецЕсли;
	
	Если МассивМест.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьСвободныеКомпоненты = Ложь;
	КоличествоПоМестам = 0;
	Для каждого Т Из МассивМест Цикл
		Кол = НоменклатураСервер.ПолучитьКоличествоПоРазмещению(ТекущийОбъект.Ссылка, Т);
		КоличествоПоМестам = КоличествоПоМестам + Кол;
		Если НЕ Т.КомпьютернаяСборка Тогда
			ЕстьСвободныеКомпоненты = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ТекущийОбъект.КомпьютернаяСборкаКомпонент Тогда
		ТекущийОбъект.КомпьютернаяСборкаЕстьСвободные = ЕстьСвободныеКомпоненты;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если КоличествоПоМестам <> ТекущийОбъект.Количество Тогда
			Сообщить("Кол-во в карточке не совпадает с количеством по местам");
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ОтложеннаяЗаписьЦен Тогда

		Если ЗначениеЗаполнено(ЦенаПриобретения) Тогда
			НоменклатураСервер.УстановитьЦену(ТекущийОбъект.Ссылка, ЦенаПриобретения, "Приобретение", ДатаПриобретения);
		КонецЕсли;		
		
		Если ЗначениеЗаполнено(ЦенаАктуальная) Тогда
			НоменклатураСервер.УстановитьЦену(ТекущийОбъект.Ссылка, ЦенаПриобретения, "На дату", ДатаПриобретения);
		КонецЕсли;		

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ПараметрыЗаписи.Вставить("Ключ", Объект.Ссылка);
	
	Оповестить("Запись_Номенклатура", ПараметрыЗаписи, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НаименованиеДляПечати(Команда)
	Объект.НаименованиеДляПечати = Объект.Наименование;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ИсторияЦен(Команда)
	
	ПараметрыОтбора = Новый Структура("Номенклатура", Объект.Ссылка);
	
	ОткрытьФорму("РегистрСведений.ЦеныНоменклатуры.ФормаСписка", Новый Структура("Отбор", ПараметрыОтбора));

КонецПроцедуры

&НаКлиенте
Процедура ЦенаАктуальнаяУстановить(Команда)

	Если ЦенаАктуальная = 0 Тогда
		Возврат;
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОтложеннаяЗаписьЦен = Истина;
		Возврат;
	КонецЕсли;

	ЦенаБазыДанных = НоменклатураСервер.ПолучитьЦену(Объект.Ссылка, "На дату").Цена;
	
	Если ЦенаБазыДанных = ЦенаАктуальная Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Цена не изменилась";
		Сообщение.Поле = "ЦенаАктуальная";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	НоменклатураСервер.УстановитьЦену(Объект.Ссылка, ЦенаАктуальная, "На дату", ДатаПриобретения);
	ПоказатьОповещениеПользователя("Цена установлена");

КонецПроцедуры

&НаКлиенте
Процедура СайтПерейти(Команда)

	Если ЗначениеЗаполнено(Объект.Сайт) Тогда
		ПерейтиПоНавигационнойСсылке(Объект.Сайт);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьРазмещение(Команда)
	
	П = Новый Структура;
	П.Вставить("Номенклатура", Объект.Ссылка);
	ОткрытьФорму("РегистрСведений.ОстаткиПоРазмещению.ФормаЗаписи", П);

КонецПроцедуры

// СтандартныеПодсистемы.РаботаСФайлами
&НаКлиенте
Процедура Подключаемый_КомандаПанелиПрисоединенныхФайлов(Команда)
	 РаботаСФайламиКлиент.КомандаУправленияПрисоединеннымиФайлами(ЭтотОбъект, Команда);
КонецПроцедуры
