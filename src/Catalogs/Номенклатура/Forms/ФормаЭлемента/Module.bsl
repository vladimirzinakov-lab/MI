#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокРазмещениеПриАктивизацииСтроки(Элемент)

	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекРазмещение = Элемент.ТекущиеДанные.Размещение;

	ОбновитьНадписьРазмещенияВПодвале(ТекРазмещение);

КонецПроцедуры

&НаКлиенте
Процедура ЦенаАктуальнаяПриИзменении(Элемент)
	
	Если ЦенаАктуальная = 0 Тогда
		Возврат;
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОтложеннаяЗаписьЦен = Истина;
		Возврат;
	КонецЕсли;
	
	ЦенаБазыДанных = НоменклатураСервер.ПолучитьЦену(Объект.Ссылка, "На дату").Цена;
	
	Если ЦенаБазыДанных = ЦенаАктуальная Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Цена не изменилась";
		Сообщение.Поле = "ЦенаАктуальная";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	НоменклатураСервер.УстановитьЦену(Объект.Ссылка, ЦенаАктуальная, "На дату", ДатаПриобретения);
	ПоказатьОповещениеПользователя("Цена установлена");

КонецПроцедуры

&НаКлиенте
Процедура ЦенаПриобретеняПриИзменении(Элемент)

	Если ЦенаПриобретения = 0 Тогда
		Возврат;
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОтложеннаяЗаписьЦен = Истина;
		Возврат;
	КонецЕсли;

	ЦенаБазыДанных = НоменклатураСервер.ПолучитьЦену(Объект.Ссылка, "Приобретение").Цена;
	
	Если ЦенаБазыДанных = ЦенаПриобретения Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Цена не изменилась";
		Сообщение.Поле = "ЦенаПриобретения";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	НоменклатураСервер.УстановитьЦену(Объект.Ссылка, ЦенаПриобретения, "Приобретение", ДатаПриобретения);
	ПоказатьОповещениеПользователя("Цена установлена");

КонецПроцедуры
	
#КонецОбласти

#Область Картинки

&НаСервереБезКонтекста
Функция НавигационнаяСсылкаКартинки(ФайлКартинки, ИдентификаторФормы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		АдресКартинки = РаботаСФайлами.ДанныеФайла(ФайлКартинки, ИдентификаторФормы).СсылкаНаДвоичныеДанныеФайла;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		АдресКартинки = "";
	КонецПопытки;
	
	Возврат АдресКартинки;
	
КонецФункции

Процедура ПоказатьКартинку()

    Если ТаблицаКартинок.Количество() > 0 Тогда
		СсылкаНаКартинку = ТаблицаКартинок[СчетчикКартинок].НавигационнаяСсылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуКартинок(п_Номенклатура)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураПрисоединенныеФайлы.Ссылка КАК Файл
		|ИЗ
		|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
		|ГДЕ
		|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
		|	И НЕ НоменклатураПрисоединенныеФайлы.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	НоменклатураПрисоединенныеФайлы.ДатаСоздания";
	
	Запрос.УстановитьПараметр("ВладелецФайла", п_Номенклатура);
	
	Таб = Запрос.Выполнить().Выгрузить();
	ТаблицаКартинок.Загрузить(Таб);
	Для каждого Т Из ТаблицаКартинок Цикл
		Т.НавигационнаяСсылка = НавигационнаяСсылкаКартинки(Т.Файл, УникальныйИдентификатор);
	КонецЦикла;
	
	Элементы.УправлениеКартинками.Видимость = ТаблицаКартинок.Количество() > 1;
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаСледующая(Команда)

	Если ТаблицаКартинок.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	СчетчикКартинок = СчетчикКартинок + 1;
	Если СчетчикКартинок = ТаблицаКартинок.Количество() Тогда
		СчетчикКартинок = 0; 
	КонецЕсли;

	СсылкаНаКартинку = ТаблицаКартинок[СчетчикКартинок].НавигационнаяСсылка;
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаПредыдущая(Команда)

	Если ТаблицаКартинок.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	СчетчикКартинок = СчетчикКартинок - 1;
	Если СчетчикКартинок < 0 Тогда
		СчетчикКартинок = ТаблицаКартинок.Количество() - 1; 
	КонецЕсли;

	СсылкаНаКартинку = ТаблицаКартинок[СчетчикКартинок].НавигационнаяСсылка;

КонецПроцедуры

#КонецОбласти

#Область Печать

Процедура УстановитьКартинкуКоманды(п_КомандаИмя)

	ПечатьЭтикеток.УстановитьКартинкуКоманды(ЭтотОбъект, п_КомандаИмя);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Напечатать(Команда)

	КомандаИзменена = ПечатьЭтикеток.ВыделитьКомандуПечати(Команда.Имя);
	
	Если КомандаИзменена Тогда
		УстановитьКартинкуКоманды(Команда.Имя);
	КонецЕсли;
	
	П = Новый Массив;
	П.Добавить(Объект.Ссылка);
	
	ТабДок = ПечатьЭтикеток.ПечатьЭтикетки50х30(П, Команда.Имя);
	ТабДок.Показать();

КонецПроцедуры

#КонецОбласти

#Область Прочее

Процедура ОбновитьНадписьРазмещенияВПодвале(п_Узел)
	
	РазмещениеПодвал = п_Узел.ПолноеНаименование();

КонецПроцедуры

#КонецОбласти	
