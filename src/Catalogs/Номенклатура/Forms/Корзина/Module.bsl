#Область СобытияЭлементовФормы

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)

	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Номенклатура) Тогда
			ПоказатьКартинку(Элемент.ТекущиеДанные.Номенклатура);
		ИначеЕсли ЗначениеЗаполнено(Элемент.ТекущиеДанные.Размещение) Тогда
			Рез = ПоказатьКартинку(Элемент.ТекущиеДанные.Размещение);
			Если Рез = 0 Тогда
				ТекНоменклатура = ПолучитьРеквизитНоменклатура(Элемент.ТекущиеДанные.Размещение);
				ПоказатьКартинку(ТекНоменклатура);
			КонецЕсли;
		КонецЕсли; 	
	КонецЕсли; 	

КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле = Элементы.ТоварыРазмещение Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			ПоказатьЗначение(Неопределено, ТекущаяСтрока.Номенклатура);
		ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Размещение) Тогда
			ПоказатьЗначение(Неопределено, ТекущаяСтрока.Размещение);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Элементы.Товары.ТекущаяСтрока = Строка;
	
	ЦелевойУзел = "";
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Размещение) Тогда
		ЦелевойУзел = Элемент.ТекущиеДанные.Размещение;
	//ИначеЕсли ЗначениеЗаполнено(Элемент.ТекущиеДанные.Номенклатура) Тогда
	//	ЦелевойУзел = НоменклатураСервер.ПолучитьРеквизитРазмещение(Элемент.ТекущиеДанные.Номенклатура);
	Иначе
		Возврат;
	КонецЕсли;

	МассивНоменклатура	= Новый Массив;
	МассивРазмещения	= Новый Массив;
	Для каждого Т Из ПараметрыПеретаскивания.Значение Цикл
		Если ТипЗнч(Т) = Тип("Число") Тогда
			ТекНоменклатура	= Товары.НайтиПоИдентификатору(Т).Номенклатура;
			ТекРазмещение	= Товары.НайтиПоИдентификатору(Т).Размещение;
			Если ЗначениеЗаполнено(ТекНоменклатура) Тогда
				МассивНоменклатура.Добавить(ТекНоменклатура);
			ИначеЕсли ЗначениеЗаполнено(ТекРазмещение) Тогда
				МассивРазмещения.Добавить(ТекРазмещение);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Т) = Тип("СправочникСсылка.Номенклатура") Тогда
			МассивНоменклатура.Добавить(Т);
		КонецЕсли;	
	КонецЦикла;
	
	Если МассивНоменклатура.Количество() > 0 Тогда
		//УстановитьРазмещение(МассивНоменклатура, ЦелевойУзел);
	ИначеЕсли МассивРазмещения.Количество() > 0 Тогда
		УстановитьСтруктуруГрупп(МассивРазмещения, ЦелевойУзел);
	КонецЕсли;

	ТекущийУзел = ЦелевойУзел;
	ЗаполнитьДеревоТовары();

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;

	Парам = Новый Структура();
	Парам.Вставить("ЦелевойУзел", ЦелевойУзел);
	Если НоменклатураСервер.ЭтоГруппа(ЦелевойУзел) Тогда
		Оповестить("Запись_ГруппыРазмещения", Парам, ЭтотОбъект);
	Иначе
		Оповестить("Запись_ЭлементаРазмещения", Парам, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)

	ОбновитьИнтерфейс();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)

	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		ПометитьНаУдаление(ТекущаяСтрока.Номенклатура);
	ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Размещение) Тогда
		ПометитьНаУдаление(ТекущаяСтрока.Размещение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КорзинаЗакрытьНажатие(Элемент)

	НастройкаНачальнойСтраницыНаСервере();
	ОбновитьИнтерфейс();

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ОбновитьДеревоТоваров(Команда)

	ЗаполнитьДеревоТовары();

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;
	
	НоменклатураКлиент.УстановитьВидимостьКорзины(Элементы);

КонецПроцедуры

&НаКлиенте
Процедура Разместить(Команда)

	ФормаРазмещения = Неопределено;
	ОкнаПриложения = ПолучитьОкна();
	Для каждого ОкноПриложения Из ОкнаПриложения Цикл
		Если ОкноПриложения.Заголовок = "Начальная страница" Тогда
			ФормаРазмещения = ОкноПриложения.Содержимое[1].ЭтаФорма;
		КонецЕсли;
	КонецЦикла;	

	Если ФормаРазмещения = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Рез = ФормаРазмещения.ПолучитьТекущуюСтроку();
	
	ЦелевойУзел = "";
	Если ЗначениеЗаполнено(Рез.Размещение) Тогда
		ЦелевойУзел = Рез.Размещение;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЦелевойУзел) Тогда
		Возврат;
	КонецЕсли;
	
	МассивНоменклатура	= Новый Массив;
	МассивРазмещения	= Новый Массив;
	Для Каждого Т Из Элементы.Товары.ВыделенныеСтроки Цикл
		Если ТипЗнч(Т) = Тип("Число") Тогда
			ТекНоменклатура	= Товары.НайтиПоИдентификатору(Т).Номенклатура;
			ТекРазмещение	= Товары.НайтиПоИдентификатору(Т).Размещение;
			Если ЗначениеЗаполнено(ТекНоменклатура) Тогда
				МассивНоменклатура.Добавить(ТекНоменклатура);
			ИначеЕсли ЗначениеЗаполнено(ТекРазмещение) Тогда
				МассивРазмещения.Добавить(ТекРазмещение);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Т) = Тип("СправочникСсылка.Номенклатура") Тогда
			МассивНоменклатура.Добавить(Т);
		КонецЕсли;	
	КонецЦикла;
	
	Если МассивНоменклатура.Количество() > 0 Тогда
		Рез = НоменклатураПеремещение(МассивНоменклатура, ЦелевойУзел);
	ИначеЕсли МассивРазмещения.Количество() > 0 Тогда
		УстановитьСтруктуруГрупп(МассивРазмещения, ЦелевойУзел);
	КонецЕсли;

	ЗаполнитьДеревоТовары();

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	
	
	ТекущийУзел = НоменклатураСервер.ПолучитьУзелКорзины_Элемент();
	
	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;
	
	НоменклатураКлиент.УстановитьВидимостьКорзины(Элементы);

	Парам = Новый Структура();
	Парам.Вставить("Ключ", ЦелевойУзел);
	Если НоменклатураСервер.ЭтоГруппа(ЦелевойУзел) Тогда
		Оповестить("Запись_ГруппыРазмещения", Парам, ЭтотОбъект);
	Иначе
		Оповестить("Запись_ЭлементаРазмещения", Парам, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры
	
#КонецОбласти

#Область Картинки

&НаСервереБезКонтекста
Функция НавигационнаяСсылкаКартинки(ФайлКартинки, ИдентификаторФормы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		АдресКартинки = РаботаСФайлами.ДанныеФайла(ФайлКартинки, ИдентификаторФормы).СсылкаНаДвоичныеДанныеФайла;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		АдресКартинки = "";
	КонецПопытки;
	
	Возврат АдресКартинки;
	
КонецФункции

Функция ПоказатьКартинку(п_ВладелецФайла)

	Запрос = Новый Запрос;

	Если ТипЗнч(п_ВладелецФайла) = Тип("СправочникСсылка.Номенклатура") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
			|ГДЕ
			|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
			|	И НЕ НоменклатураПрисоединенныеФайлы.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	НоменклатураПрисоединенныеФайлы.ДатаСоздания";
		
	ИначеЕсли ТипЗнч(п_ВладелецФайла) = Тип("СправочникСсылка.Размещения") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РазмещенияПрисоединенныеФайлы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РазмещенияПрисоединенныеФайлы КАК РазмещенияПрисоединенныеФайлы
			|ГДЕ
			|	РазмещенияПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
			|	И НЕ РазмещенияПрисоединенныеФайлы.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	РазмещенияПрисоединенныеФайлы.ДатаСоздания";
	Иначе
		Возврат 0;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВладелецФайла", п_ВладелецФайла);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения1;

		Если Выборка.Следующий() Тогда
			СсылкаНаКартинку = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		КонецЕсли;

	ИначеЕсли Выборка.Количество() = 2 Тогда
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения2;
		Выборка.Следующий();
		СсылкаНаКартинку = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку2 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
	ИначеЕсли Выборка.Количество() = 3 Тогда
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения4;
		Выборка.Следующий();
		СсылкаНаКартинку = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку2 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку3 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
	ИначеЕсли Выборка.Количество() = 4 Тогда
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения4;
		Выборка.Следующий();
		СсылкаНаКартинку = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку2 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку3 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку4 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
	Иначе		
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения1;
		СсылкаНаКартинку = "";
		СсылкаНаКартинку2 = "";
		СсылкаНаКартинку3 = "";
		СсылкаНаКартинку4 = "";
	КонецЕсли;
	
	Возврат Выборка.Количество();
	
КонецФункции

