
#Область СобытияФормы

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТекущийУзел	= Параметры.ТекущийУзел;
	
	ЗаполнитьДеревоТовары();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;

	НоменклатураКлиент.УстановитьВидимостьКорзины(Элементы);

КонецПроцедуры

&НаКлиенте
Функция ОбойтиУровеньДерева(ЭлементыДерева, п_ТекущийУзел)
	
    Для Каждого СтрокаДерева Из ЭлементыДерева Цикл 
		
    	ПодСтроки = СтрокаДерева.ПолучитьЭлементы();
		Если ПодСтроки.Количество() > 0 Тогда
			
			Если  СтрокаДерева.Размещение = ТекущийУзел Тогда
				ИдентификаторСтроки = СтрокаДерева.ПолучитьИдентификатор();
				Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
				Возврат ИдентификаторСтроки;
			КонецЕсли;
			
			Рез = ОбойтиУровеньДерева(ПодСтроки, п_ТекущийУзел);
			Если Рез <> Неопределено Тогда
				Возврат Рез;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецФункции // ()

&НаКлиенте
Процедура ПриПовторномОткрытии()

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;

КонецПроцедуры

