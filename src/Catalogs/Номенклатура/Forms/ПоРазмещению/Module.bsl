&НаКлиенте
Процедура ОбновитьДеревоТоваров(Команда)

	ЗаполнитьДеревоТовары();

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРазмещениеГруппа(Команда)

	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Парам = Новый Структура();
	Парам.Вставить("ЭтоГруппа", Истина);
	Парам.Вставить("Родитель", ТекущаяСтрока.Размещение);
	
	ОткрытьФорму("Справочник.Размещения.ФормаГруппы", Парам);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРазмещениеЭлемент(Команда)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Парам = Новый Структура();
	Парам.Вставить("Родитель", ТекущаяСтрока.Размещение);
	
	ОткрытьФорму("Справочник.Размещения.ФормаОбъекта", Парам);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущийУзел(Команда)

	ТекДанные = Элементы.Товары.ТекущиеДанные;
	
	ЦелевойУзел = "";
	Если ЗначениеЗаполнено(ТекДанные.Размещение) Тогда
		ЦелевойУзел = ТекДанные.Размещение;
	//ИначеЕсли ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
	//	ЦелевойУзел = НоменклатураСервер.ПолучитьРеквизитРазмещение(ТекДанные.Номенклатура);
	Иначе
		Возврат;
	КонецЕсли;
	
    УстановитьИсториюУзлов(ЦелевойУзел);

КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)

	СвернутьВсеДеревоРекурсивно(Товары.ПолучитьЭлементы());
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)

	Для каждого Ид Из Товары.ПолучитьЭлементы() Цикл
	    Элементы.Товары.Развернуть(Ид.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Картинки

&НаСервереБезКонтекста
Функция НавигационнаяСсылкаКартинки(ФайлКартинки, ИдентификаторФормы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		АдресКартинки = РаботаСФайлами.ДанныеФайла(ФайлКартинки, ИдентификаторФормы).СсылкаНаДвоичныеДанныеФайла;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		АдресКартинки = "";
	КонецПопытки;
	
	Возврат АдресКартинки;
	
КонецФункции

Функция ПоказатьКартинку(п_ВладелецФайла)

	Запрос = Новый Запрос;

	Если ТипЗнч(п_ВладелецФайла) = Тип("СправочникСсылка.Номенклатура") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	НоменклатураПрисоединенныеФайлы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
			|ГДЕ
			|	НоменклатураПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
			|	И НЕ НоменклатураПрисоединенныеФайлы.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	НоменклатураПрисоединенныеФайлы.ДатаСоздания";
		
	ИначеЕсли ТипЗнч(п_ВладелецФайла) = Тип("СправочникСсылка.Размещения") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РазмещенияПрисоединенныеФайлы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РазмещенияПрисоединенныеФайлы КАК РазмещенияПрисоединенныеФайлы
			|ГДЕ
			|	РазмещенияПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
			|	И НЕ РазмещенияПрисоединенныеФайлы.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	РазмещенияПрисоединенныеФайлы.ДатаСоздания";
	Иначе
		Возврат 0;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВладелецФайла", п_ВладелецФайла);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения1;

		Если Выборка.Следующий() Тогда
			СсылкаНаКартинку = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		КонецЕсли;

	ИначеЕсли Выборка.Количество() = 2 Тогда
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения2;
		Выборка.Следующий();
		СсылкаНаКартинку = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку2 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
	ИначеЕсли Выборка.Количество() = 3 Тогда
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения4;
		Выборка.Следующий();
		СсылкаНаКартинку = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку2 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку3 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
	ИначеЕсли Выборка.Количество() >= 4 Тогда
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения4;
		Выборка.Следующий();
		СсылкаНаКартинку = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку2 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку3 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
		Выборка.Следующий();
		СсылкаНаКартинку4 = НавигационнаяСсылкаКартинки(Выборка.Ссылка, УникальныйИдентификатор);
	Иначе		
		Элементы.СтраницыИзображения.ТекущаяСтраница = Элементы.СтраницаИзображения1;
		СсылкаНаКартинку = "";
		СсылкаНаКартинку2 = "";
		СсылкаНаКартинку3 = "";
		СсылкаНаКартинку4 = "";
	КонецЕсли;
	
	Возврат Выборка.Количество();
	
КонецФункции

#КонецОбласти

#Область РаботаСДеревом

Процедура УстановитьСтруктуруГрупп(п_МассивРазмещения, п_ЦелевойУзел)
	
	Для каждого Т Из п_МассивРазмещения Цикл
		Об = Т.ПолучитьОбъект();
		Об.Родитель = п_ЦелевойУзел;
		Попытка
			Об.Записать();
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьРазмещение(п_МассивНоменклатура, п_ЦелевойУзел, п_ИсходящийУзел)
	
	Для каждого Т Из п_МассивНоменклатура Цикл
		
		Если п_ЦелевойУзел.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;

		НоменклатураСервер.ИзменитьРазмещение(Т, п_ЦелевойУзел, п_ИсходящийУзел);
		НоменклатураСервер.УстановитьВариантРазмещения(Т);
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьРеквизитНоменклатура(п_Размещение)
	
	Возврат п_Размещение.Номенклатура;

КонецФункции // ()

Процедура ПостроитьДеревоРекурсивно(ВыборкаСИерархией, Дерево)
	
	Пока ВыборкаСИерархией.Следующий() Цикл
		
		Если ВыборкаСИерархией.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоИерархии Тогда

			Строка = Дерево.Строки.Добавить();
			
			Строка.Размещение				= ВыборкаСИерархией.Размещение;
			Строка.РазмещениеВыделитьЦветом	= ВыборкаСИерархией.РазмещениеВыделитьЦветом;
			Строка.КореньВетки				= Истина;

			ПостроитьДеревоРекурсивно(ВыборкаСИерархией.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "Размещение"), Строка);

		ИначеЕсли ВыборкаСИерархией.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоГруппировке Тогда
			
			Строка1 = Дерево.Строки.Добавить();
			Строка1.Размещение					= ВыборкаСИерархией.Размещение;
			Строка1.РазмещениеВыделитьЦветом	= ВыборкаСИерархией.РазмещениеВыделитьЦветом;
			Строка1.КореньВетки					= Истина;

			Выборка = ВыборкаСИерархией.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока Выборка.Следующий() Цикл
			    Строка2 = Строка1.Строки.Добавить();
			    Строка2.Номенклатура		= Выборка.Номенклатура;
			    Строка2.ВыделитьЦветом		= Выборка.ВыделитьЦветом;
			    Строка2.Количество			= Выборка.Количество;
			    Строка2.Цена				= Выборка.Цена;
			    Строка2.ЦенаПриобретения	= Выборка.ЦенаПриобретения;
			КонецЦикла;
			
		КонецЕсли;   

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьДеревоТовары()

	ДеревоРек = РеквизитФормыВЗначение("Товары");
	ДеревоРек.Строки.Очистить();

	Элементы.Товары.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВерхнийУровень;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ЦеныНоменклатурыСрезПоследних.ВидЦены.Наименование = ""На дату""
		|				ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
		|		КОНЕЦ) КАК ЦенаНаДату,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ЦеныНоменклатурыСрезПоследних.ВидЦены.Наименование = ""Приобретение""
		|				ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
		|		КОНЕЦ) КАК ЦенаПриобретения,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ЦеныНоменклатурыСрезПоследних.ВидЦены.Наименование = ""Приобретение""
		|				ТОГДА ЦеныНоменклатурыСрезПоследних.Период
		|		КОНЕЦ) КАК ДатаПриобретения
		|ПОМЕСТИТЬ ВТ_Цены
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛОЖЬ КАК КореньВетки,
		|	Размещения.Ссылка КАК Размещение,
		|	Размещения.ВыделитьЦветом КАК РазмещениеВыделитьЦветом,
		|	ОстаткиПоРазмещению.Номенклатура КАК Номенклатура,
		|	ОстаткиПоРазмещению.Количество КАК Количество,
		|	ОстаткиПоРазмещению.Номенклатура.ВыделитьЦветом КАК ВыделитьЦветом,
		|	ВТ_Цены.ЦенаНаДату КАК Цена,
		|	ВТ_Цены.ЦенаПриобретения КАК ЦенаПриобретения,
		|	ВТ_Цены.ДатаПриобретения КАК ДатаПриобретения
		|ИЗ
		|	Справочник.Размещения КАК Размещения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОстаткиПоРазмещению КАК ОстаткиПоРазмещению
		|		ПО Размещения.Ссылка = ОстаткиПоРазмещению.Размещение
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
		|		ПО (ОстаткиПоРазмещению.Номенклатура = ВТ_Цены.Номенклатура)
		|ГДЕ
		|	НЕ Размещения.ЭтоГруппа
		|	И НЕ Размещения.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Размещение,
		|	Номенклатура
		|ИТОГИ ПО
		|	Размещение ИЕРАРХИЯ
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСИерархией = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "Размещение");
	
	ПостроитьДеревоРекурсивно(ВыборкаСИерархией, ДеревоРек);
	
	ЗначениеВРеквизитФормы(ДеревоРек, "Товары");

КонецПроцедуры

&НаКлиенте
Функция ОбойтиУровеньДерева(п_ЭлементыДерева, п_ТекущийУзел)
	
    Для Каждого СтрокаДерева Из п_ЭлементыДерева Цикл 
		
    	ПодСтроки = СтрокаДерева.ПолучитьЭлементы();
		Если ПодСтроки.Количество() > 0 Тогда
			
			Если  СтрокаДерева.Размещение = п_ТекущийУзел Тогда
				ИдентификаторСтроки = СтрокаДерева.ПолучитьИдентификатор();
				Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
				Возврат ИдентификаторСтроки;
			КонецЕсли;
			
			Рез = ОбойтиУровеньДерева(ПодСтроки, п_ТекущийУзел);
			Если Рез <> Неопределено Тогда
				Возврат Рез;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецФункции // ()

&НаКлиенте
Процедура СвернутьВсеДеревоРекурсивно(п_КоллекцияЭлементов)

	Для каждого ЭлементКоллекции Из п_КоллекцияЭлементов Цикл

		ВложенныеЭлементыКоллекции = ЭлементКоллекции.ПолучитьЭлементы();
		
		Если (ВложенныеЭлементыКоллекции.Количество() > 0) Тогда
            СвернутьВсеДеревоРекурсивно(ВложенныеЭлементыКоллекции);
        Иначе
            Прервать;
        КонецЕсли;
        
        Элементы.Товары.Свернуть(ЭлементКоллекции.ПолучитьИдентификатор());
		
	КонецЦикла;
КонецПроцедуры

