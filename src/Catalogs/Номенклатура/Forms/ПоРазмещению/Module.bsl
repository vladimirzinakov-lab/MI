
#Область СобытияФормы

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТекущийУзел	= Параметры.ТекущийУзел;
	
	ЗаполнитьДеревоТовары();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастроитьФормуПриОткрытии();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()

	НастроитьФормуПриОткрытии();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_Номенклатура" Тогда

		Если Параметр.Свойство("Ключ") 
			И ЗначениеЗаполнено(Параметр.Ключ) Тогда

			МассивУзлов = НоменклатураСервер.ПолучитьРазмещения(Параметр.Ключ);
			
			Если МассивУзлов.Количество() > 0 Тогда

				ЦелевойУзел = МассивУзлов[0];

				УстановитьИсториюУзлов(ЦелевойУзел);
			
				ЗаполнитьДеревоТовары();
				КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	
				ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);
				Если ИДСтроки <> Неопределено Тогда
					Элементы.Товары.Развернуть(ИДСтроки);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Запись_ЭлементаРазмещения" Тогда
	
		Если Параметр.Свойство("Ключ") 
			И ЗначениеЗаполнено(Параметр.Ключ) Тогда
			
			НоменклатураКлиент.УстановитьВидимостьКорзины(Элементы);

			//ТекущийУзел = Параметр.Ключ;
			УстановитьИсториюУзлов(Параметр.Ключ);
			
			ЗаполнитьДеревоТовары();

			КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

			ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

			Если ИДСтроки <> Неопределено Тогда
				Элементы.Товары.Развернуть(ИДСтроки);
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ИмяСобытия = "Запись_ГруппыРазмещения" Тогда
	
		Если Параметр.Свойство("Ключ") 
			И ЗначениеЗаполнено(Параметр.Ключ) Тогда
			
			НоменклатураКлиент.УстановитьВидимостьКорзины(Элементы);

			//ТекущийУзел = Параметр.Ключ;
			УстановитьИсториюУзлов(Параметр.Ключ);
			
			ЗаполнитьДеревоТовары();

			КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

			ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

			Если ИДСтроки <> Неопределено Тогда
				Элементы.Товары.Развернуть(ИДСтроки);
			КонецЕсли;
		КонецЕсли;
	
	ИначеЕсли ИмяСобытия = "ПомещениеВКорзину" Тогда
	
		НоменклатураКлиент.УстановитьВидимостьКорзины(Элементы);
		
		//ТекущийУзел = НоменклатураСервер.ПолучитьУзелКорзины_Элемент();
		УстановитьИсториюУзлов(НоменклатураСервер.ПолучитьУзелКорзины_Элемент());
		
		ЗаполнитьДеревоТовары();

		КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

		ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

		Если ИДСтроки <> Неопределено Тогда
			Элементы.Товары.Развернуть(ИДСтроки);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

