Процедура УстановитьВидимостьИсторииУзлов()
	
	Если ЗначениеЗаполнено(ТекущийУзел) Тогда
		Элементы.ТекущийУзел.Видимость = Истина;
		Элементы.ТекущийУзел.Заголовок = ТекущийУзел;
	Иначе
		Элементы.ТекущийУзел.Видимость = Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущийУзел1) Тогда
		Элементы.ТекущийУзел1.Видимость = Истина;
		Элементы.ТекущийУзел1.Заголовок = ТекущийУзел1;
	Иначе
		Элементы.ТекущийУзел1.Видимость = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийУзел2) Тогда
		Элементы.ТекущийУзел2.Видимость = Истина;
		Элементы.ТекущийУзел2.Заголовок = ТекущийУзел2;
	Иначе
		Элементы.ТекущийУзел2.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьИсториюУзлов(Знач п_Узел)

	НоменклатураКлиент.УстановитьИсториюУзлов(ЭтаФорма, п_Узел);	
	
	УстановитьВидимостьИсторииУзлов();

КонецПроцедуры

Процедура ПометитьНаУдаление(п_Размещение)

	Об = п_Размещение.ПолучитьОбъект();
	Об.УстановитьПометкуУдаления(Истина, Истина);

КонецПроцедуры

Процедура НастройкаНачальнойСтраницыНаСервере()

	НастройкиНачальнойСтраницы = Новый НастройкиНачальнойСтраницы; 
	СоставФормНачальнойСтраницы = Новый СоставФормНачальнойСтраницы;

	СоставФормНачальнойСтраницы.ЛеваяКолонка.Добавить("Справочник.Номенклатура.Форма.Корзина");
	СоставФормНачальнойСтраницы.ПраваяКолонка.Добавить("Справочник.Номенклатура.Форма.ПоРазмещению");
	НастройкиНачальнойСтраницы.УстановитьСоставФорм(СоставФормНачальнойСтраницы);        
	ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы",, НастройкиНачальнойСтраницы);

КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуПриОткрытии()

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	
	
	СвернутьВсеДеревоРекурсивно(КоллекцияЭлементовДерева);
	
	Если МассивУзловРазмещения.Количество() > 1 Тогда
		Для каждого УзелРазмещения Из МассивУзловРазмещения Цикл
			ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, УзелРазмещения.Значение);
			Если ИДСтроки <> Неопределено Тогда
				Элементы.Товары.Развернуть(ИДСтроки);
			КонецЕсли;
		КонецЦикла;
	Иначе		
		ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);
		Если ИДСтроки <> Неопределено Тогда
			Элементы.Товары.Развернуть(ИДСтроки);
		КонецЕсли;
	КонецЕсли;
	
    НоменклатураКлиент.УстановитьВидимостьКорзины(Элементы);
	УстановитьВидимостьИсторииУзлов();

КонецПроцедуры

