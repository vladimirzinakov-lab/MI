&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)

	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Номенклатура) Тогда
			ПоказатьКартинку(Элемент.ТекущиеДанные.Номенклатура);
		ИначеЕсли ЗначениеЗаполнено(Элемент.ТекущиеДанные.Размещение) Тогда
			Рез = ПоказатьКартинку(Элемент.ТекущиеДанные.Размещение);
			Если Рез = 0 Тогда
				ТекНоменклатура = ПолучитьРеквизитНоменклатура(Элемент.ТекущиеДанные.Размещение);
				ПоказатьКартинку(ТекНоменклатура);
			КонецЕсли;
		КонецЕсли; 	
	КонецЕсли; 	

КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле = Элементы.ТоварыРазмещение Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
			ПоказатьЗначение(Неопределено, ТекущаяСтрока.Номенклатура);
		ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Размещение) Тогда
			ПоказатьЗначение(Неопределено, ТекущаяСтрока.Размещение);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ИсходящийУзел = Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока).ПолучитьРодителя().Размещение;
	
	Элементы.Товары.ТекущаяСтрока = Строка;
	
	ЦелевойУзел = "";
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Размещение) Тогда
		ЦелевойУзел = Элемент.ТекущиеДанные.Размещение;
	ИначеЕсли ЗначениеЗаполнено(Элемент.ТекущиеДанные.Номенклатура) Тогда
		//ЦелевойУзел = НоменклатураСервер.ПолучитьРеквизитРазмещение(Элемент.ТекущиеДанные.Номенклатура);
		Сообщить("Целевой узел не определен");
		Возврат;
	Иначе
		Возврат;
	КонецЕсли;

	МассивНоменклатура	= Новый Массив;
	МассивРазмещения	= Новый Массив;
	Для каждого Т Из ПараметрыПеретаскивания.Значение Цикл
		Если ТипЗнч(Т) = Тип("Число") Тогда
			ТекНоменклатура	= Товары.НайтиПоИдентификатору(Т).Номенклатура;
			ТекРазмещение	= Товары.НайтиПоИдентификатору(Т).Размещение;
			Если ЗначениеЗаполнено(ТекНоменклатура) Тогда
				МассивНоменклатура.Добавить(ТекНоменклатура);
			ИначеЕсли ЗначениеЗаполнено(ТекРазмещение) Тогда
				МассивРазмещения.Добавить(ТекРазмещение);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Т) = Тип("СправочникСсылка.Номенклатура") Тогда
			МассивНоменклатура.Добавить(Т);
		КонецЕсли;	
	КонецЦикла;
	
	Если МассивНоменклатура.Количество() > 0 Тогда
		УстановитьРазмещение(МассивНоменклатура, ЦелевойУзел, ИсходящийУзел);
	ИначеЕсли МассивРазмещения.Количество() > 0 Тогда
		УстановитьСтруктуруГрупп(МассивРазмещения, ЦелевойУзел);
	КонецЕсли;

	//ТекущийУзел = ЦелевойУзел;
	УстановитьИсториюУзлов(ЦелевойУзел);
	
	ЗаполнитьДеревоТовары();

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;

	НоменклатураКлиент.УстановитьВидимостьКорзины(Элементы);
	
	Парам = Новый Структура();
	Парам.Вставить("ЦелевойУзел", ЦелевойУзел);
	Если НоменклатураСервер.ЭтоГруппа(ЦелевойУзел) Тогда
		Оповестить("Запись_ГруппыРазмещения", Парам, ЭтотОбъект);
	Иначе
		Оповестить("Запись_ЭлементаРазмещения", Парам, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)

	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		ПометитьНаУдаление(ТекущаяСтрока.Номенклатура);
	ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Размещение) Тогда
		ПометитьНаУдаление(ТекущаяСтрока.Размещение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КорзинаНажатие(Элемент)
	
	НастройкаНачальнойСтраницыНаСервере();
	ОбновитьИнтерфейс();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекущийУзел1(Элемент)

	ВремТекущийУзел = ТекущийУзел;
	ТекущийУзел = ТекущийУзел1;

	ЗаполнитьДеревоТовары();

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;

	ТекущийУзел = ВремТекущийУзел;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекущийУзел2(Элемент)

	ВремТекущийУзел = ТекущийУзел;
	ТекущийУзел = ТекущийУзел2;

	ЗаполнитьДеревоТовары();

	КоллекцияЭлементовДерева = Товары.ПолучитьЭлементы();	

	ИДСтроки = ОбойтиУровеньДерева(КоллекцияЭлементовДерева, ТекущийУзел);

	Если ИДСтроки <> Неопределено Тогда
		Элементы.Товары.Развернуть(ИДСтроки);
	КонецЕсли;

	ТекущийУзел = ВремТекущийУзел;

КонецПроцедуры

#КонецОбласти

