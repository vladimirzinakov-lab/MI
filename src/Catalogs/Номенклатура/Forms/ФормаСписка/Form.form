    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ВЫБОР
			КОГДА ЦеныНоменклатурыСрезПоследних.ВидЦены.Наименование = &quot;На дату&quot;
				ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
		КОНЕЦ) КАК ЦенаНаДату,
	МАКСИМУМ(ВЫБОР
			КОГДА ЦеныНоменклатурыСрезПоследних.ВидЦены.Наименование = &quot;Приобретение&quot;
				ТОГДА ЦеныНоменклатурыСрезПоследних.Цена
		КОНЕЦ) КАК ЦенаПриобретения,
	МАКСИМУМ(ВЫБОР
			КОГДА ЦеныНоменклатурыСрезПоследних.ВидЦены.Наименование = &quot;Приобретение&quot;
				ТОГДА ЦеныНоменклатурыСрезПоследних.Период
		КОНЕЦ) КАК ДатаПриобретения
ПОМЕСТИТЬ ВТ_Цены
ИЗ
	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних

СГРУППИРОВАТЬ ПО
	ЦеныНоменклатурыСрезПоследних.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СправочникНоменклатура.Ссылка КАК Ссылка,
	СправочникНоменклатура.ПометкаУдаления КАК ПометкаУдаления,
	СправочникНоменклатура.Родитель КАК Родитель,
	СправочникНоменклатура.ЭтоГруппа КАК ЭтоГруппа,
	СправочникНоменклатура.Код КАК Код,
	СправочникНоменклатура.Наименование КАК Наименование,
	СправочникНоменклатура.Комментарий КАК Комментарий,
	СправочникНоменклатура.Количество КАК Количество,
	СправочникНоменклатура.МестоПриобретения КАК МестоПриобретения,
	СправочникНоменклатура.Местоположение КАК Местоположение,
	СправочникНоменклатура.ВариантРазмещения КАК ВариантРазмещения,
	СправочникНоменклатура.ВыделитьЦветом КАК ВыделитьЦветом,
	СправочникНоменклатура.КомпьютернаяСборкаЕстьСвободные КАК КомпьютернаяСборкаЕстьСвободные,
	СправочникНоменклатура.КомпьютернаяСборкаКомпонент КАК КомпьютернаяСборкаКомпонент,
	СправочникНоменклатура.ЭтикеткаРаспечатана КАК ЭтикеткаРаспечатана,
	ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, ЛОЖЬ) КАК ЕстьФайлы,
	ВТ_Цены.ЦенаНаДату КАК Цена,
	ВТ_Цены.ЦенаПриобретения КАК ЦенаПриобретения,
	ВТ_Цены.ДатаПриобретения КАК ДатаПриобретения
ИЗ
	Справочник.Номенклатура КАК СправочникНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО СправочникНоменклатура.Ссылка = НаличиеФайлов.ОбъектСФайлами
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
		ПО СправочникНоменклатура.Ссылка = ВТ_Цены.Номенклатура</queryText>
