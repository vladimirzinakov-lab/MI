Функция ПолучитьМассивРеквизитов(п_МассивНоменклатуры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Комментарий КАК Комментарий,
		|	Номенклатура.МестоПриобретения КАК МестоПриобретения
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&Номенклатура)";
	
	Запрос.УстановитьПараметр("Номенклатура", п_МассивНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Рез = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		СтрокаРеквизитов = Новый Структура("МестоПриобретения, Комментарий");
		ЗаполнитьЗначенияСвойств(СтрокаРеквизитов, Выборка);
		Рез.Добавить(СтрокаРеквизитов);
	КонецЦикла;
	
	Возврат Рез;

КонецФункции // ()

Процедура УстановитьРеквизиты(п_Номенклатура, п_МассивРеквизитов) Экспорт

	Рез_Комментарий		= "#";
	Рез_МестоПриобретения	= "#";

	Для каждого Т Из п_МассивРеквизитов Цикл
		Если СтрНайти(Рез_Комментарий, Т.Комментарий) = 0 Тогда
			Рез_Комментарий = Рез_Комментарий + ", " + Т.Комментарий;
		КонецЕсли;
		
		Если СтрНайти(Рез_МестоПриобретения, Т.МестоПриобретения) = 0 Тогда
			Рез_МестоПриобретения = Рез_МестоПриобретения + ", " + Т.МестоПриобретения;
		КонецЕсли;
	КонецЦикла;

	Рез_Комментарий			= СтрЗаменить(Рез_Комментарий, "#, ", "");
	Рез_МестоПриобретения	= СтрЗаменить(Рез_МестоПриобретения, "#, ", "");

	Рез_Комментарий			= СтрЗаменить(Рез_Комментарий, "#", "");
	Рез_МестоПриобретения	= СтрЗаменить(Рез_МестоПриобретения, "#", "");
	
	Об = п_Номенклатура.ПолучитьОбъект();
	Об.Комментарий			= Рез_Комментарий;
	Об.МестоПриобретения	= Рез_МестоПриобретения;

	Попытка
		Об.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;


КонецПроцедуры


#КонецОбласти